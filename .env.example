# Copy to .env on the server and adjust to match the existing Traefik setup.
DOMAIN=avolites.olliecross.com
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
# Middleware defined in traefik dynamic_conf.yml (security headers + HSTS)
TRAEFIK_MIDDLEWARES=secHeaders@file
# Daily check time, UTC
UPDATE_AT=03:30
